{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kivo Product Studio",
  "identifier": "cn.wleo.kivo.product-studio",
  "build": {
    "beforeDevCommand": "npm run dev -- --mode studio --port 1421",
    "devUrl": "http://localhost:1421/studio.html",
    "beforeBuildCommand": "npm run build -- --mode studio",
    "frontendDist": "../dist-studio"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kivo Product Studio",
        "width": 1380,
        "height": 860,
        "minWidth": 980,
        "minHeight": 680
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "resources": {},
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
